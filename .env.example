# on the same network: http://localhost,http://192.168.1.25
CORS_ORIGIN=http://localhost
PORT=80
BACKEND_ORIGIN=backend:3000
# Required — the coach chat needs this. Get one at console.anthropic.com
ANTHROPIC_API_KEY=
